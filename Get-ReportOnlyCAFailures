    }
    finally {
        Remove-Item -LiteralPath $temp -Force -ErrorAction SilentlyContinue
        $writer.Dispose()
    }

    $emptyCursor = [PageCursor]::new()
    $emptyWriter = [IO.StringWriter]::new()
    $emptyStream = [IO.MemoryStream]::new([Text.Encoding]::UTF8.GetBytes('{ "value": [] }'))
    try {
        [SignInPageReader]::Consume(
            $emptyStream,
            $emptyWriter,
            $emptyCursor,
            $results,
            '',
            '',
            $false,
            $tally,
            $samples
        )
    }
    finally {
        $emptyStream.Dispose()
        $emptyWriter.Dispose()
    }

    if ($null -ne $emptyCursor.NextLink -or $emptyCursor.Scanned -ne 0) {
        throw 'An empty page should end the chain.'
    }

    Write-Host 'SelfTest passed.' -ForegroundColor Green
}

if ($SelfTest) {
    Invoke-SelfTest
    return
}

$script:SelectList = 'id,createdDateTime,userPrincipalName,userDisplayName,appDisplayName,resourceDisplayName,clientAppUsed,isInteractive,appliedConditionalAccessPolicies,ipAddress,location,deviceDetail,status,correlationId'
$script:UseSelect = $true
$script:ServerFilterMode = 'Full'
$script:QueryModeLocked = $false
$script:PolicyGuid = ''
$parsedGuid = [guid]::Empty
if ($PolicyId -and [guid]::TryParse($PolicyId, [ref]$parsedGuid)) {
    $script:PolicyGuid = $parsedGuid.ToString('D')
}

$script:ResultSet = [System.Collections.Generic.HashSet[string]]::new(
    [StringComparer]::OrdinalIgnoreCase
)
foreach ($resultName in $Results) {
    [void]$script:ResultSet.Add([string]$resultName)
}

$script:ResultTally = [System.Collections.Generic.Dictionary[string, long]]::new(
    [StringComparer]::OrdinalIgnoreCase
)
$script:SamplePolicies = [System.Collections.Generic.List[string]]::new()
$script:IntervalSeconds = 10.0 / $RequestsPer10Sec
$script:FastestInterval = $script:IntervalSeconds
$script:NextAllowedUtc = [DateTime]::UtcNow
$script:Requests = 0
$script:Throttles = 0
$script:SuccessStreak = 0
$script:TotalScanned = [long]0
$script:TotalMatched = [long]0
$script:ResumedScanned = [long]0
$script:ResumedMatched = [long]0
$script:ResumedSlices = 0
$script:CompletedSlices = 0
$script:SawPolicies = $false
$script:CheckedVisibility = [long]0
$script:WarnedCa = $false
$script:SamplePrinted = $false
$script:HintedInFlight = $false
$script:LatencyTotal = 0.0
$script:LatencyCount = 0
$script:ProbeAuthRetried = $false
$script:TokenExpiresUtc = [DateTime]::UtcNow
$script:Cancel = [System.Threading.CancellationTokenSource]::new()
$script:InFlight = [System.Collections.Generic.List[object]]::new()
$script:Ready = [System.Collections.Generic.Stack[object]]::new()
$script:Waiting = [System.Collections.Generic.Queue[object]]::new()

if (-not (Get-Module -ListAvailable -Name Microsoft.Graph.Authentication)) {
    throw @'
Microsoft.Graph.Authentication is not installed.
Install it with:
  Install-Module Microsoft.Graph.Authentication -Scope CurrentUser
'@
}

Import-Module Microsoft.Graph.Authentication -ErrorAction Stop

$connectParams = @{
    Scopes        = @('AuditLog.Read.All')
    UseDeviceCode = $true
    NoWelcome     = $true
    ErrorAction   = 'Stop'
}

if ($TenantId -and $TenantId -ne 'organizations') {
    $connectParams.TenantId = $TenantId
}

Write-Host 'Signing in to Microsoft Graph...' -ForegroundColor Cyan
Connect-MgGraph @connectParams

$context = Get-MgContext
if (-not $context) {
    throw 'Connect-MgGraph completed without an active Microsoft Graph context.'
}

Write-Host "Authenticated as: $($context.Account)" -ForegroundColor Green
Update-GraphBearer
$script:NextAllowedUtc = [DateTime]::UtcNow.AddSeconds($script:IntervalSeconds)

$outFullPath = Resolve-UserPath $OutFile
$outParent = Split-Path -Parent $outFullPath
if (-not (Test-Path -LiteralPath $outParent)) {
    New-Item -ItemType Directory -Path $outParent -Force | Out-Null
}

if (-not $PartDir) {
    $PartDir = Join-Path $outParent ('careportonly_parts_' + (Get-Date -Format 'yyyyMMdd_HHmmss'))
}

$PartDir = Resolve-UserPath $PartDir
New-Item -ItemType Directory -Path $PartDir -Force | Out-Null

$planPath = Join-Path $PartDir 'slices.json'
$plan = $null
if ($Resume -and (Test-Path -LiteralPath $planPath)) {
    $plan = Get-Content -LiteralPath $planPath -Raw | ConvertFrom-Json
    if (-not (Test-PlanFilter $plan)) {
        throw "The slice plan in $planPath was built for a different -Results, -PolicyId, -PolicyName, or -InteractiveOnly value. Use a new -PartDir, or resume with the same filters."
    }
}

if ($plan) {
    $script:WindowStart = [string]$plan.StartUtc
    $script:WindowEnd = [string]$plan.EndUtc
    $script:AllSlices = [System.Collections.Generic.List[object]]::new()
    foreach ($item in @($plan.Slices)) {
        $script:AllSlices.Add((New-SliceObject -Index ([int]$item.Index) -From ([string]$item.From) -To ([string]$item.To)))
    }

    $savedStart = [DateTime]::Parse(
        $script:WindowStart,
        [Globalization.CultureInfo]::InvariantCulture,
        [Globalization.DateTimeStyles]::RoundtripKind
    )
    $savedEnd = [DateTime]::Parse(
        $script:WindowEnd,
        [Globalization.CultureInfo]::InvariantCulture,
        [Globalization.DateTimeStyles]::RoundtripKind
    )
    $savedDays = ($savedEnd - $savedStart).TotalDays
    if ([Math]::Abs($savedDays - $Days) -gt 0.05) {
        Write-Warning "Resuming the saved window $($script:WindowStart) -> $($script:WindowEnd). -Days $Days is not reapplied."
    }
}
else {
    if ($Resume) {
        Write-Warning 'This part directory has no slices.json. Slice boundaries follow the clock from this run. Use a new -PartDir when the earlier run did not record its window.'
    }

    $endUtc = [DateTime]::UtcNow
    $startUtc = $endUtc.AddDays(-$Days)
    $window = $endUtc - $startUtc
    $maxSlice = [TimeSpan]::FromHours($SliceHours)
    $minSlice = [TimeSpan]::FromMinutes(15)
    $sliceLength = $maxSlice
    if ($window.Ticks -gt 0) {
        $countAtMax = [Math]::Ceiling($window.TotalHours / $maxSlice.TotalHours)
        if ($countAtMax -lt $MaxInFlight) {
            $sliceLength = [TimeSpan]::FromTicks([long]($window.Ticks / $MaxInFlight))
            if ($sliceLength -lt $minSlice) {
                $sliceLength = $minSlice
            }
            if ($sliceLength -gt $maxSlice) {
                $sliceLength = $maxSlice
            }
        }
    }

    $script:WindowStart = ConvertTo-GraphUtc $startUtc
    $script:WindowEnd = ConvertTo-GraphUtc $endUtc
    $script:AllSlices = New-SliceList -StartUtc $startUtc -EndUtc $endUtc -SliceLength $sliceLength
    Write-SlicePlan -Directory $PartDir
}

if (-not $Resume) {
    Get-ChildItem -LiteralPath $PartDir -File -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -like 'part_*.csv' -or $_.Name -like 'part_*.csv.done' } |
        Remove-Item -Force
}

foreach ($slice in $script:AllSlices) {
    if ($Resume -and (Test-Path -LiteralPath $slice.DoneFile)) {
        $meta = Read-DoneMeta $slice.DoneFile
        $script:ResumedScanned += $meta.Scanned
        $script:ResumedMatched += $meta.Matched
        $script:ResumedSlices++
        $script:CompletedSlices++
        $slice.Done = $true
        $fromText = if ($slice.From.Length -ge 13) { $slice.From.Substring(0, 13) } else { $slice.From }
        Write-Host ("slice {0,-3} {1} SKIPPED (complete)" -f $slice.Index, $fromText) -ForegroundColor DarkGreen
        continue
    }

    Remove-Item -LiteralPath $slice.PartFile -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath $slice.DoneFile -Force -ErrorAction SilentlyContinue
}

$script:PendingSlices = @($script:AllSlices | Where-Object { -not $_.Done })
$sliceHoursText = if ($script:AllSlices.Count -gt 0) {
    $first = $script:AllSlices[0]
    $fromStamp = [DateTime]::Parse($first.From, [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind)
    $toStamp = [DateTime]::Parse($first.To, [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind)
    [Math]::Round(($toStamp - $fromStamp).TotalHours, 2)
}
else {
    $SliceHours
}

Write-Host "`nWindow : $($script:WindowStart) -> $($script:WindowEnd)" -ForegroundColor Cyan
Write-Host "Slices : $($script:AllSlices.Count) x up to ${sliceHoursText}h, newest first, $MaxInFlight in flight" -ForegroundColor Cyan
Write-Host "Pace   : $([Math]::Round($script:IntervalSeconds, 2)) seconds/request (cap $RequestsPer10Sec per 10s)" -ForegroundColor Cyan
Write-Host "Match  : $($Results -join ', ')`n" -ForegroundColor Cyan

$handler = [System.Net.Http.SocketsHttpHandler]::new()
$decompress = [System.Net.DecompressionMethods]::GZip -bor [System.Net.DecompressionMethods]::Deflate
if ([enum]::GetNames([System.Net.DecompressionMethods]) -contains 'Brotli') {
    $decompress = $decompress -bor [System.Net.DecompressionMethods]::Brotli
}

$handler.AutomaticDecompression = $decompress
$handler.MaxConnectionsPerServer = [Math]::Max(8, $MaxInFlight)
$handler.PooledConnectionLifetime = [TimeSpan]::FromMinutes(15)
if ([System.Net.Http.SocketsHttpHandler].GetProperty('EnableMultipleHttp2Connections')) {
    $handler.EnableMultipleHttp2Connections = $true
}
$script:Http = [System.Net.Http.HttpClient]::new($handler)
$script:Http.Timeout = [TimeSpan]::FromSeconds(180)
$script:Stopwatch = [Diagnostics.Stopwatch]::StartNew()

try {
    if ($script:PendingSlices.Count -eq 0) {
        Write-Host 'All slices are already complete.' -ForegroundColor DarkGreen
    }
    else {
        Invoke-QueryProbe
        $mode = switch ($script:ServerFilterMode) {
            'Full' { 'server-side report-only filter' }
            'IdOnly' { 'server-side policy id filter' }
            default { 'local match across every sign-in' }
        }

        $shape = if ($script:UseSelect) { '$select on' } else { 'full sign-in records' }
        Write-Host "Query  : $mode, $shape" -ForegroundColor Cyan

        foreach ($slice in $script:PendingSlices) {
            $slice.Uri = New-SignInUri -Filter (Get-SliceFilter $slice)
            $script:Waiting.Enqueue($slice)
        }

        Invoke-SignInDownload
    }

    if (-not $script:WarnedCa -and -not $script:SawPolicies -and ($script:TotalScanned + $script:ResumedScanned) -gt 0 -and $script:CheckedVisibility -gt 0) {
        Write-Warning 'appliedConditionalAccessPolicies was empty on every sign-in read during this run.'
        Write-Warning 'The account may read sign-ins but lack a role that can read Conditional Access data.'
    }

    $averageLatency = if ($script:LatencyCount -gt 0) {
        $script:LatencyTotal / $script:LatencyCount
    }
    else {
        0
    }

    Write-Host (
        "`nRequests: {0} | Throttled: {1} | Pace: {2:N2}s | Avg latency: {3:N2}s" -f
        $script:Requests,
        $script:Throttles,
        $script:IntervalSeconds,
        $averageLatency
    ) -ForegroundColor DarkCyan

    if ($Diagnose -and $script:ResultTally.Count -gt 0) {
        Write-Host "`n--- Report-only results observed during this run ---" -ForegroundColor Magenta
        $script:ResultTally.GetEnumerator() |
            Sort-Object Value -Descending |
            Select-Object `
                @{ Name = 'Policy | Result'; Expression = { $_.Key } },
                @{ Name = 'Count'; Expression = { $_.Value } } |
            Format-Table -AutoSize
    }

    $merged = Merge-PartFiles -Destination $outFullPath
    $script:Stopwatch.Stop()

    if (-not $merged) {
        Write-Warning "Scanned $($script:TotalScanned) sign-ins during this run and found no completed part files containing matches."
        Write-Warning 'Run a shorter window with -Diagnose to see which report-only results are present.'
        return
    }

    Write-Host "`nDone in $($script:Stopwatch.Elapsed.ToString('hh\:mm\:ss'))" -ForegroundColor Green
    Write-Host "Scanned this run : $($script:TotalScanned)" -ForegroundColor Green
    Write-Host "Matched this run : $($script:TotalMatched)" -ForegroundColor Green
    if ($Resume) {
        Write-Host "Scanned resumed  : $($script:ResumedScanned)" -ForegroundColor Green
        Write-Host "Matched resumed  : $($script:ResumedMatched)" -ForegroundColor Green
    }

    Write-Host "CSV              : $outFullPath" -ForegroundColor Green
    Write-Host "Parts            : $PartDir" -ForegroundColor DarkGray

    $rollups = @([SignInPageReader]::Summarize($outFullPath) | Where-Object { $null -ne $_ })
    if ($rollups.Count -gt 0) {
        $rollups |
            Sort-Object Events -Descending |
            Format-Table Policy, Events, UniqueUsers -AutoSize
    }
}
catch {
    try {
        $script:Cancel.Cancel()
    }
    catch {
    }

    foreach ($job in @($script:InFlight)) {
        try {
            [void]$job.Task.Wait(3000)
        }
        catch {
        }

        try {
            $job.Request.Dispose()
        }
        catch {
        }

        if ($job.Task.Status -eq [Threading.Tasks.TaskStatus]::RanToCompletion) {
            try {
                $job.Task.Result.Dispose()
            }
            catch {
            }
        }
    }

    foreach ($slice in @($script:AllSlices)) {
        Clear-IncompleteSlice $slice
    }

    throw
}
finally {
    if ($script:Http) {
        $script:Http.Dispose()
    }
}
